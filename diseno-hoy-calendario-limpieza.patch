+/* ---------------------------------------------------------------------------
+ * Escala tipografica basica.
+ *
+ * Antes casi todo el texto de la app usaba font-black (800/900) sin importar
+ * si era un titulo, una etiqueta o un valor: todo "gritaba" con la misma
+ * fuerza y no habia jerarquia real entre las piezas de una card. Estas cinco
+ * clases dan un vocabulario consistente para reemplazar esos usos sueltos,
+ * empezando por Hoy y Calendario (ver app-shell.tsx). El font-black se
+ * reserva para el valor de una metrica, que es lo unico que conviene que
+ * "pese" mas que el resto dentro de una card.
+ * ------------------------------------------------------------------------ */
+@layer utilities {
+  .text-h1 {
+    font-size: clamp(1.75rem, 1.5rem + 1vw, 2rem);
+    font-weight: 800;
+    line-height: 1.15;
+    letter-spacing: -0.01em;
+  }
+
+  .text-h2 {
+    font-size: clamp(1.05rem, 1rem + 0.2vw, 1.125rem);
+    font-weight: 700;
+    line-height: 1.3;
+    letter-spacing: -0.005em;
+  }
+
+  .text-body {
+    font-size: 0.9rem;
+    font-weight: 500;
+    line-height: 1.55;
+  }
+
+  .text-label {
+    font-size: 0.72rem;
+    font-weight: 700;
+    line-height: 1.2;
+    letter-spacing: 0.06em;
+    text-transform: uppercase;
+    color: #6b7a70;
+  }
+
+  .text-value {
+    font-size: clamp(1.4rem, 1.25rem + 0.5vw, 1.6rem);
+    font-weight: 800;
+    line-height: 1.1;
+    letter-spacing: -0.01em;
+  }
+}
+
 :root {
   color-scheme: light;
   --background: #fbf9f1;
