-    font-size: 0.78rem;
+    display: inline-flex;
+    align-items: center;
+    justify-content: center;
     line-height: 1;
   }
 
+  .calendar-event-icon svg {
+    display: block;
+  }
+
+  /* .event-water/.event-photo/.event-clean/.event-review tambien se usan como
+     fondo de pill en otras partes del calendario; aca solo interesa el color
+     del trazo del icono, asi que se anula el fondo para no meter un cuadrado
