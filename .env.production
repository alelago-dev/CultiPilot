# Configuracion de Supabase para el sitio publicado en GitHub Pages.
#
# Estas dos variables son publicas por diseno: Next.js las incrusta en el
# JavaScript que se descarga en el navegador de cualquier visitante, asi que
# no son un secreto y pueden vivir en el repositorio.
#
# Lo que protege los datos NO es esta clave, sino las reglas de Row Level
# Security definidas en supabase/schema.sql: cada usuario solo puede leer y
# escribir sus propias filas, aunque tenga la clave anon.
#
# NUNCA pegar aca la clave "service_role" de Supabase: esa si es secreta y
# saltea todas las reglas de seguridad.

NEXT_PUBLIC_SUPABASE_URL=https://bcajyoxupcneeyrvuzkz.supabase.co

# Pegar aca la clave "anon / public" del proyecto de Supabase.
# Esta en el panel de Supabase: Settings -> API Keys -> anon public.
# Es una cadena larga que arranca con "eyJ".
# Mientras este vacia, la app sigue funcionando en modo demo local.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_MniRGoW0OxFVNbIg3vWsYA__6F2_sLQ

# Clave publica VAPID para notificaciones push (ver supabase/functions/send-reminders).
# Es publica por diseno, igual que la anon key de arriba: lo que protege
# las suscripciones es RLS en push_subscriptions (supabase/schema.sql). La
# clave PRIVADA nunca va en este archivo -- vive solo como secret de la
# Edge Function (VAPID_PRIVATE_KEY), configurada por fuera del repo.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=BObqZcCsr4K14HJIS0hexT2pIY9zwDlsNdr8TlbsnGVpTKtFzno9w61Ns3cm1kt3zKERTO5YuOmptVZsUokShoM
